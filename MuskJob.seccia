"dialogs": [
{
"sid": 15,
"uid": "D_LOST",
"content": {
"sentence": {
"voice": {
"en": [
{},
{},
{},
{}
]
},
"sentences": [
{
"id": 1,
"text": {
"en": "Salut ! je suis ta conscience et je suis la pour t'aider à te déplacer a travers les niveaux. \r\nTu pourras venir me voir lorsque tu voudras retourner dans des niveaux que tu auras deja visités."
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"anim": "TALK",
"speaker": "O_ABDUL_JAFFAR"
},
{
"id": 2,
"text": {
"en": "Oh je vois que tu as récupérer la seringue !\r\nUtilise la seringue, peut-être qu'ilse passera quelque chose !"
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_ABDUL_JAFFAR",
"anim": "TALK"
}
]
},
"nextID": 3
}
},
{
"sid": 38,
"uid": "D_RYTHM",
"content": {
"sentence": {
"voice": {
"en": [
{},
{},
{},
{}
]
},
"sentences": [
{
"id": 1,
"text": {
"en": "Salut ! tu viens d'arriver dans ce mini-jeu.\r\nUne séquence audio va se jouer, a toi de refaire cette séquence en cliquant sur les bon boutons.\r\nReviens vers moi si tu souhaite réecouter un son si tu n'a pas bien entendu.\r\nBonne chance ! "
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_OIIA_CAT"
},
{
"id": 2,
"text": {
"en": "Attention prochain son !"
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_OIIA_CAT"
},
{
"id": 5,
"text": {
"en": "Dommage tu n'a pas réussi recommence !\r\n"
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_OIIA_CAT"
},
{
"id": 6,
"text": {
"en": "Quel son souhaite-tu réecouter ?"
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"sentences": [
{
"id": 7,
"choice": true,
"text": {
"en": "OIIA\r\n"
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"never_hide": true,
"exit": true
},
{
"id": 8,
"choice": true,
"text": {
"en": "I'm blue\r\n"
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"never_hide": true,
"exit": true
},
{
"id": 9,
"choice": true,
"text": {
"en": "Baby it me one more time\r\n"
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"never_hide": true,
"exit": true
},
{
"id": 10,
"choice": true,
"text": {
"en": "Sugar\r\n\r\n"
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"never_hide": true,
"exit": true
}
],
"speaker": "O_OIIA_CAT"
},
{
"id": 12,
"text": {
"en": "Bravo tu réussi ce mini-jeu !\r\nVoila ta récompense.\r\n"
},
"voice": {
"en": [
{},
{},
{},
{}
]
},
"speaker": "O_OIIA_CAT"
}
]
},
"nextID": 13
}
}
